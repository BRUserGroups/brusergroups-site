---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteData } from '../lib/data';
---

<BaseLayout title={`${siteData.brand} | About`}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">About</p>
      <h1>Baton Rouge User Groups</h1>
      <p>
        A free, no-registration-required community for professionals and students across SQL Server,
        .NET, and data/analytics — meeting monthly in Baton Rouge since the early 2000s.
      </p>
    </div>
  </section>

  <section class="panel prose-panel">
    <h2>Who we are</h2>
    <p>
      Baton Rouge User Groups (BRUG) is the umbrella for three sibling technology communities that
      meet jointly, free and with no registration required. The group aims to provide a platform for
      growing your skillset in Information Technology and your professional network.
    </p>
    <p>
      We meet every second Wednesday of the month on a wide range of topics including Business Intelligence,
      Disaster Recovery, SQL Server performance and monitoring, SQL Server and .NET development, and
      data analytics.
    </p>
    <p>
      The goal is to help the Baton Rouge area technology community become more involved, educated, and
      capable technology professionals.
    </p>

    <h2>Our member groups</h2>
    <p>
      BRUG meetings bring together three groups under one roof each month:
    </p>
    <ul>
      <li><strong>Baton Rouge SQL Server User Group (BRSSUG)</strong> — <a href="http://brssug.org" target="_blank" rel="noreferrer">brssug.org</a></li>
      <li><strong>Baton Rouge .NET User Group (BRDNUG)</strong> — <a href="http://brdnug.org" target="_blank" rel="noreferrer">brdnug.org</a></li>
      <li><strong>Baton Rouge Analytics & Intelligence Network (BRAIN)</strong> — <a href="https://gobrain.org" target="_blank" rel="noreferrer">gobrain.org</a></li>
    </ul>

    <h2>Not-for-profit corporation</h2>
    <p>
      <strong>Baton Rouge User Groups</strong> is a Louisiana not-for-profit corporation (501c6) formed
      to support all three member groups and their events with financial logistics, including Day of
      Data. Our EIN and a W-9 are available upon request.
    </p>


    <h2>Day of Data Baton Rouge</h2>
    <p>
      BRUG hosts an annual full-day data conference — free sessions, great speakers, and the Baton
      Rouge data community all in one place. For more information on speaking, volunteering, or attending, visit
      <a href="https://www.dayofdatabr.org/" target="_blank" rel="noreferrer">dayofdatabr.org</a>.
    </p>

    <h2>Organizers</h2>
    <p>
      <a href="https://www.linkedin.com/in/kennyneal225/" target="_blank" rel="noreferrer">Kenny Neal</a> ·
      <a href="https://www.linkedin.com/in/balaji-nedurumalli/" target="_blank" rel="noreferrer">Balaji Nedurumalli</a> ·
      <a href="https://www.linkedin.com/in/andyparkerson/" target="_blank" rel="noreferrer">Andy Parkerson</a> ·
      <a href="https://www.linkedin.com/in/thomaslleblanc/" target="_blank" rel="noreferrer">Thomas LeBlanc</a>
    </p>
    <p>
      Questions? Email us at <a href={`mailto:${siteData.contactEmail}`}>{siteData.contactEmail}</a>.
    </p>
  </section>
</BaseLayout>
