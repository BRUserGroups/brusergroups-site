---
import type { SiteData } from '../lib/types';

type NavLink = { label: string; href: string; external?: boolean };

type Props = {
  siteData: SiteData;
  logoSrc?: string;
  logoWhiteSrc?: string;
  iconSrc?: string;
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  extraNavLinks?: NavLink[];
};

const {
  siteData,
  logoSrc,
  logoWhiteSrc,
  iconSrc,
  title = siteData.title,
  description = siteData.description,
  ogTitle,
  ogDescription,
  ogImage,
  ogUrl,
  extraNavLinks = []
} = Astro.props as Props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
const resolvedOgImage = ogImage ?? (iconSrc ? `${base}/${iconSrc}` : undefined);
const resolvedOgUrl = ogUrl ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    {iconSrc && <link rel="icon" type="image/png" href={`${base}/${iconSrc}`} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteData.brand} meetings`} href={`${base}/rss.xml`} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta property="og:url" content={resolvedOgUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href={`${base}/`}>
          {logoSrc
            ? <img src={`${base}/${logoSrc}`} alt={`${siteData.brand} – ${siteData.fullName}`} class="site-logo" />
            : (
              <>
                <span class="brand-abbr">{siteData.brand}</span>
                <span class="brand-full">{siteData.fullName}</span>
              </>
            )
          }
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href={`${base}/meetings/`}>Meetings</a>
          <a href={`${base}/call-for-speakers/`}>Speak</a>
          <a href={`${base}/about/`}>About</a>
          <a href={`${base}/sponsorship/`}>Sponsorship</a>
          <a href={`${base}/jobs/`}>Jobs</a>
          {extraNavLinks.map((link) => (
            <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label}</a>
          ))}
          <a href={`${base}/contact/`}>Contact</a>
          <a class="nav-cta" href={siteData.meetupUrl} target="_blank" rel="noreferrer">Join on Meetup</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-brand">
          <a class="footer-brand-link" href={`${base}/`}>
            {logoWhiteSrc
              ? <img src={`${base}/${logoWhiteSrc}`} alt={siteData.fullName} class="footer-logo" />
              : (
                <>
                  <span class="footer-brand-name">{siteData.brand}</span>
                  <span class="footer-brand-full">{siteData.fullName}</span>
                </>
              )
            }
          </a>
          <p class="footer-tagline">{siteData.meetingSchedule}</p>
          <p class="footer-tagline">Streamed &amp; recorded on <a href={siteData.youtubeUrl} target="_blank" rel="noreferrer" class="footer-link">YouTube</a></p>
        </div>
        <nav class="footer-nav" aria-label="Footer">
          <div class="footer-col">
            <p class="footer-col-title">Group</p>
            <a href={`${base}/meetings/`}>Meetings</a>
            <a href={`${base}/about/`}>About</a>
            <a href={`${base}/location/`}>Location</a>
            <a href={`${base}/calendar/`}>Calendar</a>
          </div>
          <div class="footer-col">
            <p class="footer-col-title">Participate</p>
            <a href={`${base}/call-for-speakers/`}>Call for Speakers</a>
            <a href={`${base}/jobs/`}>Jobs</a>
            <a href={`${base}/sponsorship/`}>Sponsorship</a>
            <a href={`${base}/contact/`}>Contact &amp; Social</a>
            <a href={`mailto:${siteData.contactEmail}`}>Email organizers</a>
          </div>
          <div class="footer-col">
            <p class="footer-col-title">Community</p>
            <a href={siteData.meetupUrl} target="_blank" rel="noreferrer">Meetup</a>
            <a href={siteData.sessionizeUrl} target="_blank" rel="noreferrer">Sessionize</a>
            <a href={siteData.youtubeUrl} target="_blank" rel="noreferrer">YouTube</a>
            <a href={`${base}/rss.xml`}>RSS</a>
            <a href={`${base}/code-of-conduct/`}>Code of Conduct</a>
            {extraNavLinks.map((link) => (
              <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label}</a>
            ))}
          </div>
        </nav>
        <p class="footer-sync">Last synced {new Date(siteData.lastSyncedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
      </footer>
    </div>
  </body>
</html>
